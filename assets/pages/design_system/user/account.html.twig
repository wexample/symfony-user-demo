{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{%- block page_body -%}
    {%- set user = app.user -%}
    <article class="content">
        <h1>{{ '@page::page_title' | trans }}</h1>

        <dl>
            <dt>{{ '@page::field.email' | trans }}</dt>
            <dd>{{ user.email }}</dd>
            <dt>{{ '@page::field.username' | trans }}</dt>
            <dd>{{ user.username ?? '—' }}</dd>
            <dt>{{ '@page::field.roles' | trans }}</dt>
            <dd>{{ user.roles | join(', ') }}</dd>
            <dt>{{ '@page::field.date_last_login' | trans }}</dt>
            <dd>{{ user.dateLastLogin ? user.dateLastLogin | date('Y-m-d H:i') : '—' }}</dd>
            <dt>{{ '@page::field.date_created' | trans }}</dt>
            <dd>{{ user.dateCreated | date('Y-m-d H:i') }}</dd>
        </dl>

        <p>{{ button_link('ph:bold/sign-out', '@page::action.logout' | trans, path('user_security_logout')) }}</p>
    </article>
{%- endblock -%}
