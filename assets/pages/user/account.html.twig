{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    {%- set user = app.user -%}
    {%- set roles -%}
        {%- for role in user.roles -%}{{ marker('neutral', role, { compact: true }) }} {% endfor -%}
    {%- endset -%}

    <section class="block block--padded">
        {{ properties([
            { key: '@page::field.email' | trans, value: user.email },
            { key: '@page::field.username' | trans, value: user.username ?? '—' },
            { key: '@page::field.roles' | trans, value: roles, html: true },
            { key: '@page::field.date_last_login' | trans, value: user.dateLastLogin ? date_display(user.dateLastLogin, 'date_time_short') : '—', html: true },
            { key: '@page::field.date_created' | trans, value: date_display(user.dateCreated, 'date_time_short'), html: true },
        ], { columns: true }) }}
    </section>

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/device-mobile') }}</span>
            <span class="block--title-label">{{ '@page::authenticator.title' | trans }}</span>
        </div>
        <div class="block--body">
            <p class="text-secondary">{{ (app.user.totpAuthenticationEnabled ? '@page::authenticator.on' : '@page::authenticator.off') | trans }}</p>
        </div>
        <div class="block--footer">
            <span></span>
            {{ button_link('ph:bold/device-mobile', '@page::authenticator.open' | trans, path('user_totp_index')) }}
        </div>
    </section>

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/devices') }}</span>
            <span class="block--title-label">{{ '@page::devices.title' | trans }}</span>
        </div>
        <div class="block--body">
            <p class="text-secondary">{{ '@page::devices.intro' | trans }}</p>
        </div>
        <div class="block--footer">
            <span></span>
            <form method="post" action="{{ path('user_revoke_devices') }}">
                {{ button('ph:bold/prohibit', '@page::devices.revoke' | trans, { type: 'submit' }) }}
            </form>
        </div>
    </section>

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/password') }}</span>
            <span class="block--title-label">{{ '@page::change_password' | trans }}</span>
        </div>
        <div class="block--body">
            {{ form_load(render_pass, change_password_form, '@WexampleSymfonyUserBundle/forms/change_password_form.html.twig') }}
        </div>
    </section>

    <div class="cluster">
        {{ button_link('ph:bold/sign-out', '@page::action.logout' | trans, path('user_security_logout'), { class: 'button--flat' }) }}
    </div>
{%- endblock -%}
