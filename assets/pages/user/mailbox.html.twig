{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    {%- if mail -%}
        {#- The last mail, as it would have arrived: who it was for, until
            when it holds, and what it carries — a link to follow, or a code to
            type where it is asked for. -#}
        <section class="block block--card">
            <div class="block--title">
                <span class="block--title-leading">{{ icon(mail.is_link ? 'ph:bold/link' : 'ph:bold/shield-check') }}</span>
                <span class="block--title-label">{{ ('@page::type.' ~ mail.type) | trans }}</span>
            </div>
            <div class="block--body stack--vertical">
                {{ properties([
                    { key: '@page::field.to' | trans, value: mail.to },
                    { key: '@page::field.expires_at' | trans, value: date_display(mail.expires_at, 'date_time_short'), html: true },
                ]) }}
                {%- if not mail.is_link -%}
                    <p class="lead">{{ '@page::field.code' | trans }} <code>{{ mail.value }}</code></p>
                {%- endif -%}
            </div>
            {%- if mail.is_link -%}
                <div class="block--footer">
                    <span></span>
                    {{ button_link('ph:bold/sign-in', '@page::action.follow' | trans, mail.value, { class: 'button--invert' }) }}
                </div>
            {%- endif -%}
        </section>
    {%- else -%}
        <div class="block block--padded empty">{{ '@page::empty' | trans }}</div>
    {%- endif -%}

    {%- if totp_code -%}
        <section class="block block--card">
            <div class="block--title">
                <span class="block--title-leading">{{ icon('ph:bold/device-mobile') }}</span>
                <span class="block--title-label">{{ '@page::totp.title' | trans }}</span>
            </div>
            <div class="block--body stack--vertical">
                <p class="text-secondary">{{ '@page::totp.intro' | trans }}</p>
                <p class="lead">{{ '@page::field.code' | trans }} <code>{{ totp_code }}</code></p>
            </div>
        </section>
    {%- endif -%}

    <div class="cluster">
        {{ button_link('ph:bold/arrow-left', '@page::action.back' | trans, path('user_index'), { class: 'button--flat' }) }}
    </div>
{%- endblock -%}
