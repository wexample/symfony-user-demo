{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{%- block page_body -%}
    <article class="content">
        <h1>{{ '@page::page_title' | trans }}</h1>

        {%- if app.user -%}
            <p>{{ '@page::signed_in' | trans({'%name%': app.user.displayName}) }}</p>
            <p>
                {{ button_link('ph:bold/user-circle', '@page::action.account' | trans, path('user_account')) }}
                {{ button_link('ph:bold/sign-out', '@page::action.logout' | trans, path('user_security_logout')) }}
            </p>
        {%- else -%}
            <p>{{ '@page::intro' | trans }}</p>

            {%- if accounts_created -%}
                <table>
                    <thead>
                        <tr>
                            <th>{{ '@page::accounts.email' | trans }}</th>
                            <th>{{ '@page::accounts.username' | trans }}</th>
                            <th>{{ '@page::accounts.password' | trans }}</th>
                            <th>{{ '@page::accounts.expected' | trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {%- for account in accounts -%}
                            <tr>
                                <td><code>{{ account.email }}</code></td>
                                <td><code>{{ account.username }}</code></td>
                                <td><code>{{ account.password }}</code></td>
                                <td>{{ ('@page::accounts.result.' ~ account.name | lower) | trans }}</td>
                            </tr>
                        {%- endfor -%}
                    </tbody>
                </table>
            {%- else -%}
                <p>{{ '@page::accounts.missing' | trans }} <code>bin/console user-demo:create-accounts</code></p>
            {%- endif -%}

            {{ form_load(render_pass, login_form, '@WexampleSymfonyUserBundle/forms/login_form.html.twig') }}

            <h2>{{ '@page::magic_link.title' | trans }}</h2>
            <p>{{ '@page::magic_link.intro' | trans }}</p>
            {{ form_load(render_pass, magic_link_request_form, '@WexampleSymfonyUserBundle/forms/magic_link_request_form.html.twig') }}
            <p>{{ button_link('ph:bold/envelope-simple', '@page::action.mailbox' | trans, path('user_mailbox')) }}</p>
        {%- endif -%}
    </article>
{%- endblock -%}
