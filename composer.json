{
  "name": "wexample/symfony-user-demo",
  "description": "User accounts showcase pages for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "5.0.4",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyUserDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-loader": ">=20.0.0",
    "wexample/symfony-design-system": ">=29.0.0",
    "wexample/symfony-design-system-demo": ">=10.0.0",
    "wexample/symfony-routing": ">=2.0.0",
    "wexample/symfony-user": ">=10.0.0",
    "wexample/symfony-user-ds": ">=3.0.0",
    "wexample/symfony-mail-ds": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}